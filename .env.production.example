# Configuration de PRODUCTION (serveur good-entrepreneur.sn)
#   cp .env.production.example .env
# puis remplacer chaque valeur A_GENERER par une valeur forte :
#   openssl rand -base64 48

# Demarre aussi nginx + certbot avec "docker compose up -d"
COMPOSE_PROFILES=prod

# --- Domaines ---
SITE_DOMAIN=good-entrepreneur.sn
APP_DOMAIN=app.good-entrepreneur.sn
API_DOMAIN=api.good-entrepreneur.sn
# Recoit les avertissements d'expiration des certificats HTTPS
LETSENCRYPT_EMAIL=contact@good-entrepreneur.sn

# --- PostgreSQL ---
POSTGRES_DB=fleetmanager
POSTGRES_USER=fleetmanager
POSTGRES_PASSWORD=A_GENERER

# --- Backend ---
APP_JWT_SECRET=A_GENERER
APP_JWT_ACCESS_EXPIRATION_MS=1800000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_CORS_ALLOWED_ORIGINS=https://app.good-entrepreneur.sn

# Compte administrateur cree au premier demarrage (changer le mot de passe apres connexion)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@good-entrepreneur.sn
APP_BOOTSTRAP_ADMIN_PASSWORD=A_GENERER

# --- Frontend (inline au build : reconstruire le frontend si modifie) ---
NEXT_PUBLIC_API_URL=https://api.good-entrepreneur.sn
