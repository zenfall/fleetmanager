# Copier ce fichier en ".env" et personnaliser les valeurs avant "docker compose up"

# --- PostgreSQL ---
POSTGRES_DB=fleetmanager
POSTGRES_USER=fleetmanager
POSTGRES_PASSWORD=change-me-please

# --- Backend ---
# Genere une valeur aleatoire forte, par ex: openssl rand -base64 48
APP_JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
APP_JWT_ACCESS_EXPIRATION_MS=1800000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Compte administrateur cree automatiquement au premier demarrage
APP_BOOTSTRAP_ADMIN_EMAIL=admin@fleetmanager.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-please-Admin1!

# --- Frontend ---
# URL du backend telle qu'accessible depuis le NAVIGATEUR de l'utilisateur final
NEXT_PUBLIC_API_URL=http://localhost:8080
